{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "fps": {
      "default": 30,
      "anyOf": [
        {
          "type": "number",
          "const": 24
        },
        {
          "type": "number",
          "const": 30
        },
        {
          "type": "number",
          "const": 60
        }
      ]
    },
    "width": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "height": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "duration": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "source": {
      "default": {},
      "type": "object",
      "properties": {
        "recordingId": {
          "type": "string"
        },
        "highlightId": {
          "type": "string"
        }
      }
    },
    "assets": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "enum": [
              "video",
              "audio",
              "image",
              "font"
            ]
          },
          "src": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.-]+$"
          },
          "width": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "height": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "duration": {
            "type": "number",
            "minimum": 0
          }
        },
        "required": [
          "id",
          "kind",
          "src"
        ]
      }
    },
    "tracks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "enum": [
              "video",
              "audio",
              "caption",
              "text",
              "overlay"
            ]
          },
          "items": {
            "type": "array",
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "type": {
                      "type": "string",
                      "const": "video"
                    },
                    "assetId": {
                      "type": "string",
                      "minLength": 1
                    },
                    "start": {
                      "type": "number",
                      "minimum": 0
                    },
                    "duration": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    },
                    "sourceStart": {
                      "type": "number",
                      "minimum": 0
                    },
                    "sourceEnd": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    },
                    "volume": {
                      "default": 1,
                      "type": "number",
                      "minimum": 0,
                      "maximum": 3.98
                    },
                    "cropKeyframes": {
                      "minItems": 1,
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "t": {
                            "type": "number",
                            "minimum": 0
                          },
                          "crop_x": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 9007199254740991
                          },
                          "crop_y": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 9007199254740991
                          },
                          "crop_width": {
                            "type": "integer",
                            "exclusiveMinimum": 0,
                            "maximum": 9007199254740991
                          },
                          "crop_height": {
                            "type": "integer",
                            "exclusiveMinimum": 0,
                            "maximum": 9007199254740991
                          },
                          "layout": {
                            "type": "string",
                            "enum": [
                              "crop",
                              "panel"
                            ]
                          },
                          "region": {
                            "type": "string"
                          },
                          "transition_mode": {
                            "type": "string",
                            "enum": [
                              "start",
                              "hold",
                              "ease",
                              "cut",
                              "manual"
                            ]
                          }
                        },
                        "required": [
                          "t",
                          "crop_x",
                          "crop_y",
                          "crop_width",
                          "crop_height",
                          "layout",
                          "region",
                          "transition_mode"
                        ]
                      }
                    }
                  },
                  "required": [
                    "id",
                    "type",
                    "assetId",
                    "start",
                    "duration",
                    "sourceStart",
                    "sourceEnd",
                    "cropKeyframes"
                  ]
                },
                {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "type": {
                      "type": "string",
                      "const": "caption"
                    },
                    "start": {
                      "type": "number",
                      "minimum": 0
                    },
                    "duration": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    },
                    "words": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "text": {
                            "type": "string",
                            "minLength": 1
                          },
                          "start": {
                            "type": "number",
                            "minimum": 0
                          },
                          "end": {
                            "type": "number",
                            "minimum": 0
                          },
                          "isCode": {
                            "default": false,
                            "type": "boolean"
                          }
                        },
                        "required": [
                          "text",
                          "start",
                          "end"
                        ]
                      }
                    }
                  },
                  "required": [
                    "id",
                    "type",
                    "start",
                    "duration",
                    "words"
                  ]
                }
              ]
            }
          }
        },
        "required": [
          "id",
          "kind",
          "items"
        ]
      }
    },
    "brand": {
      "type": "object",
      "properties": {
        "name": {
          "default": "",
          "type": "string",
          "maxLength": 80
        },
        "handle": {
          "default": "",
          "type": "string",
          "maxLength": 40
        },
        "colors": {
          "type": "object",
          "properties": {
            "background": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            },
            "text": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            },
            "accent": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            }
          },
          "required": [
            "background",
            "text",
            "accent"
          ]
        },
        "fonts": {
          "type": "object",
          "properties": {
            "body": {
              "type": "string",
              "minLength": 1
            },
            "code": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "body",
            "code"
          ]
        }
      },
      "required": [
        "colors",
        "fonts"
      ]
    },
    "captionStyle": {
      "type": "object",
      "properties": {
        "preset": {
          "default": "highlight-word",
          "type": "string",
          "enum": [
            "highlight-word"
          ]
        },
        "fontSize": {
          "default": 64,
          "type": "integer",
          "minimum": 24,
          "maximum": 120
        },
        "maxCharsPerLine": {
          "default": 32,
          "type": "integer",
          "minimum": 10,
          "maximum": 60
        },
        "maxLines": {
          "default": 2,
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        },
        "safeTop": {
          "default": 1350,
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "safeBottom": {
          "default": 1650,
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    },
    "renderSettings": {
      "type": "object",
      "properties": {
        "quality": {
          "default": "looks",
          "type": "string",
          "enum": [
            "draft",
            "looks",
            "delivery"
          ]
        }
      }
    }
  },
  "required": [
    "id",
    "schemaVersion",
    "width",
    "height",
    "duration",
    "assets",
    "tracks",
    "brand",
    "captionStyle",
    "renderSettings"
  ]
}
