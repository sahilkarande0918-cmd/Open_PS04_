# Copy to apps/web/.env.local and apps/api/.env. Never commit real values.
# Details: docs/ENVIRONMENT.md

# ---- frontend (public config) ----
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=

# ---- backend (local machine only) ----
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SECRET_KEY=            # SECRET — sb_secret_..., backend only
TOKEN_ENCRYPTION_KEY=           # SECRET — 32 random bytes, base64
ALLOWED_ORIGINS=http://localhost:3000
DATA_DIR=./data
OLLAMA_URL=http://localhost:11434
PUBLIC_API_URL=

# ASR (backend). Path to a CTranslate2 model dir or a faster-whisper model name.
WHISPER_MODEL=large-v3-turbo
WHISPER_LANGUAGE=
